{
  "name": "tgdeck",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first, multi-column Telegram board",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "demo": "node src/cli.ts --demo",
    "dev": "node --watch src/cli.ts --demo",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "guard": "node scripts/guard.ts --all",
    "build:mac": "node scripts/build-macos.ts",
    "prepare": "node scripts/install-hooks.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "prebuilt-tdlib": "0.1008067.0",
    "tdl": "8.1.0"
  }
}
